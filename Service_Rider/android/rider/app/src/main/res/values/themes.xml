<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SuperRescuer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sr_primary</item>
        <item name="colorOnPrimary">@color/sr_on_primary</item>
        <item name="colorPrimaryContainer">@color/sr_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/sr_on_primary_container</item>
        <item name="colorSecondary">@color/sr_secondary</item>
        <item name="colorOnSecondary">@color/sr_on_secondary</item>
        <item name="colorSecondaryContainer">@color/sr_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/sr_on_secondary_container</item>
        <item name="colorTertiary">@color/sr_tertiary</item>
        <item name="colorOnTertiary">@color/sr_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/sr_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/sr_on_tertiary_container</item>
        <item name="android:colorBackground">@color/sr_background</item>
        <item name="colorOnBackground">@color/sr_on_background</item>
        <item name="colorSurface">@color/sr_surface</item>
        <item name="colorOnSurface">@color/sr_on_surface</item>
        <item name="colorSurfaceVariant">@color/sr_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/sr_on_surface_variant</item>
        <item name="colorOutline">@color/sr_outline</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
