# Docker Compose web deployment
RIDER_HOST_PORT=13000
RIDER_BIND_ADDR=0.0.0.0

# Airtest Agent must use the same key.
DEVICE_SHARED_KEY=nuwa8888

# Set to 0 for quieter WebSocket logs.
WS_FRAME_DEBUG=1

# Host persistence paths used by docker-compose.yml.
SUPER_RESCUER_DATA_DIR=/opt/super-rescuer/data
SUPER_RESCUER_RECORDINGS_DIR=/opt/super-rescuer/recordings

# CORS origins. Use comma-separated origins for production.
ALLOWED_ORIGINS=*
